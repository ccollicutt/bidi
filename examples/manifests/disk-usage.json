{
  "manifest_version": 1,
  "plugin_id": "disk-usage",
  "version": "1.0.0",
  "api_version": 1,
  "publisher_key_id": "operations-2026",
  "artifacts": [],
  "actions": [{
    "name": "disk-usage.measure",
    "description": "Measure the configured mount point",
    "input_schema": {"type":"object","required":["path"],"properties":{"path":{"const":"/tmp"}},"additionalProperties":false},
    "output_schema": {"type":"object","required":["path","total_bytes","free_bytes"],"properties":{"path":{"const":"/tmp"},"total_bytes":{"type":"integer"},"free_bytes":{"type":"integer"}},"additionalProperties":false},
    "timeout_seconds": 5,
    "max_result_bytes": 4096,
    "read_only": true
  }],
  "capabilities": {"filesystem_read": ["/tmp"], "network": []}
}
